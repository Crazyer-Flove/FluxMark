{
  "appId": "io.github.crazyer-flove.fluxmark",
  "productName": "FluxMark",
  "directories": { "output": "release" },
  "files": ["dist/**/*", "desktop/main.cjs", "desktop/fluxmark.ico", "package.json", "!node_modules/**/*"],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "artifactName": "FluxMark-Setup-${version}-Windows-${arch}.exe",
    "icon": "desktop/fluxmark.ico",
    "signExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "FluxMark",
    "installerIcon": "desktop/fluxmark.ico",
    "uninstallerIcon": "desktop/fluxmark.ico"
  }
}
